{
  "editor.quickSuggestions": false,
  "editor.suggestOnTriggerCharacters": false,
  "editor.wordBasedSuggestions": "off",
  "editor.inlineSuggest.enabled": false,
  "editor.tabCompletion": "off",
  "editor.acceptSuggestionOnCommitCharacter": false,
  "editor.acceptSuggestionOnEnter": "off",
  "editor.snippetSuggestions": "none",
  "latex-workshop.intellisense.package.enabled": false,
  "latex-workshop.intellisense.citation.enabled": false,
  "latex-workshop.intellisense.reference.enabled": false,
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.recipe.default": "first",
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.view.pdf.tab.editorGroup": "right",
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": false
  },

  "editor.suggestOnTriggerCharacters": true,
  "editor.inlineSuggest.enabled": false,
  "editor.snippetSuggestions": "inline",
  "editor.acceptSuggestionOnEnter": "on", 
  "latex-workshop.intellisense.enabled": true,
  "latex-workshop.hover.enabled": true,

  "cSpell.enabled": true,
  "cSpell.language": "en",
  "cSpell.showSuggestions": true,

  "cSpell.enableFiletypes": [
    "latex",
    "plaintext",
    "markdown"
  ]
}
